# =============================================================================
# NEXUS 33 — Variáveis de ambiente (frontend / Vite)
# Copie este arquivo para .env e preencha com os valores do SEU projeto Supabase.
# Todos os VITE_* são embutidos no bundle no build (são valores PÚBLICOS).
# =============================================================================

# Supabase / Lovable Cloud — obrigatórios
VITE_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable_anon_key>"
VITE_SUPABASE_PROJECT_ID="<PROJECT_REF>"

# Também consumidos pelo Supabase CLI local (mesmos valores acima, sem VITE_)
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable_anon_key>"

# Feature flags (opcionais — default ON)
VITE_AUTO_BET_ENABLED="true"
VITE_SUPERBET_CONNECT_ENABLED="true"

# =============================================================================
# SECRETS DE BACKEND (NÃO vão neste arquivo — vão em
# Supabase Dashboard → Edge Functions → Secrets, ou via `supabase secrets set`)
# =============================================================================
# SUPABASE_URL                  (auto-injetado pelo runtime)
# SUPABASE_ANON_KEY             (auto-injetado)
# SUPABASE_SERVICE_ROLE_KEY     (auto-injetado)
# SPORTSRC_API_KEY              https://sportsrc.org  (free 1000/dia)
# FOOTBALL_DATA_ORG_KEY         https://www.football-data.org
# TELEGRAM_BOT_TOKEN            @BotFather
# TELEGRAM_CHAT_ID              chat/canal alvo
# TELEGRAM_ADMIN_CHAT_ID        (opcional) canal admin
# LOVABLE_API_KEY               Lovable AI Gateway   (opcional — analistas IA)
# GEMINI_API_KEY                (opcional — fallback IA)
# GROQ_API_KEY                  (opcional — fallback IA)
# APP_PUBLIC_URL                URL pública do frontend publicado

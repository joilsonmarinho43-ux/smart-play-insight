# =====================================================================
# NEXUS 33 — VPS (copie para deploy/.env e preencha)
# =====================================================================

# Domínios (crie registros A apontando para o IP da VPS)
APP_DOMAIN=analista.seudominio.com.br
API_DOMAIN=api.seudominio.com.br

# Frontend (valores PÚBLICOS, embutidos no bundle)
VITE_SUPABASE_URL=https://api.seudominio.com.br
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY_gerado_pelo_supabase_selfhost>
VITE_SUPABASE_PROJECT_ID=selfhosted

# --- Secrets do backend (vão em supabase-docker/.env e nas edge functions) ---
SPORTSRC_API_KEY=
FOOTBALL_DATA_ORG_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LOVABLE_API_KEY=
APP_PUBLIC_URL=https://analista.seudominio.com.br

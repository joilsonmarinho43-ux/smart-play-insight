# =====================================================================
# NEXUS 33 — VPS (copie para deploy/.env e preencha)
# =====================================================================

# --- Domínios (crie registros A apontando para o IP da VPS) ----------
APP_DOMAIN=analista.funecob.com.br
API_DOMAIN=api.funecob.com.br
APP_PUBLIC_URL=https://analista.funecob.com.br

# --- Frontend (PREENCHIDO AUTOMATICAMENTE pelo install-vps.sh) -------
# Não é preciso editar: o script grava a URL da API e a ANON_KEY gerada.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=selfhosted

# --- Secrets das Edge Functions (OBRIGATÓRIOS) -----------------------
SPORTSRC_API_KEY=
FOOTBALL_DATA_ORG_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opcionais -------------------------------------------------------
# TELEGRAM_API_KEY é espelhado do BOT_TOKEN se ficar vazio.
# TELEGRAM_ADMIN_CHAT_ID cai para TELEGRAM_CHAT_ID se ficar vazio.
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_API_KEY=
LOVABLE_API_KEY=
